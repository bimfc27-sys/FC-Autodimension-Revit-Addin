{
  "name": "camerascope-free-edition",
  "version": "1.0.0",
  "private": true,
  "description": "CameraScope Free Edition: Cloudflare Pages + Pages Functions + D1",
  "scripts": {
    "build:frontend": "bash scripts/build-frontend.sh",
    "dev": "wrangler pages dev public --local --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply camerascope --local",
    "db:migrate:remote": "wrangler d1 migrations apply camerascope --remote",
    "typecheck": "tsc --noEmit",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "hono": "4.13.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261121.1",
    "typescript": "5.6.3",
    "wrangler": "4.166.0"
  }
}
