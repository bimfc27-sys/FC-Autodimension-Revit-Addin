# CameraScope Free Edition - Cloudflare Pages project (free plan).
# Static PWA in ./public, API in ./functions (Pages Functions), data in D1.
name = "camerascope"
# Copied to wrangler.toml by scripts/deploy.sh (CLI deploys) and for local dev.
# NOT used by Cloudflare's GitHub integration: there, bind the D1 database as "DB" in the dashboard.
pages_build_output_dir = "public"
compatibility_date = "2026-11-01"
compatibility_flags = ["nodejs_compat"]

[[d1_databases]]
binding = "DB"
database_name = "camerascope"
database_id = "00000000-0000-0000-0000-000000000000"   # replaced by scripts/deploy.sh
migrations_dir = "migrations"

[vars]
# first_user_only: only the first account may self-register (it becomes the admin).
REGISTRATION_MODE = "first_user_only"
PBKDF2_ITERATIONS = "100000"
# Secrets (set with `wrangler pages secret put`): CREDENTIAL_KEY (base64 32 bytes)
