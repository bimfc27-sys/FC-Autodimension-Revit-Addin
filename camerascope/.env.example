# ---- CameraScope configuration -------------------------------------------
# Generate secrets with ./scripts/generate-secrets.sh (writes .env).

# Hostname served by Caddy. "localhost" uses a locally trusted internal CA;
# a public DNS name gets a Let's Encrypt certificate automatically.
SITE_ADDRESS=localhost
# Public IP or hostname browsers use to reach WebRTC media (UDP 8189).
PUBLIC_HOST=localhost

POSTGRES_PASSWORD=change-me
# >= 32 random characters
JWT_SECRET=change-me
# Comma separated "key_id:base64(32 random bytes)". First key encrypts; all decrypt.
CREDENTIAL_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES

# true  = self-hosted: allow cameras on RFC1918 / LAN addresses
# false = multi-tenant hosting: only public internet camera addresses allowed
ALLOW_PRIVATE_NETWORK_TARGETS=true

# Public camera providers: seed, caltrans, nyc_dot, osm, windy, demo
PROVIDERS_ENABLED=seed,caltrans,nyc_dot,osm
CALTRANS_DISTRICTS=3,4,7,11,12
# Optional: free key from https://api.windy.com/webcams (enable "windy" above)
WINDY_API_KEY=
