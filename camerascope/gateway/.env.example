# ---- CameraScope Local Camera Gateway ----------------------------------
# Your CameraScope address (must be https://)
CLOUD_URL=https://camerascope.example.com

# One-time code from CameraScope > Manage > Gateways > Add gateway.
# Used only on first start; afterwards the gateway secret is kept in the
# gateway-state volume. Leave it here or delete it after enrollment.
ENROLLMENT_CODE=

# REQUIRED: the camera/NVR networks this gateway may connect to (CIDR, comma separated).
# Anything outside these ranges is refused by the gateway itself.
ALLOWED_SUBNETS=192.168.1.0/24

# Ports the gateway may open on those hosts ("*" = any). Default covers
# RTSP/RTSPS, HTTP(S)/ONVIF and common recorder ports.
#ALLOWED_PORTS=80,443,554,322,8000,8080,8081,8443,8554,8899,8888,8889,9000,34567,37777

# Only if CameraScope uses a private CA (e.g. local testing):
#CLOUD_CA_FILE=/data/ca.crt

RELAY_USER=relay
# RELAY_PASS is generated by ./generate-relay-secret.sh
